---
/**
 * Three404Scene.astro
 *
 * Interactive 3D Origami Crane (Bird) floating in zero gravity.
 * Features articulated flapping wings, gentle aerodynamic hover bobbing,
 * mouse-tracking parallax banking, click-to-soar acrobatics, ambient dust motes,
 * and dynamic Dark/Light theme adaptation.
 */
---

<div class="three-404-container" data-three-404 aria-hidden="true">
  <canvas class="three-404-canvas" data-three-canvas></canvas>
  <div class="three-404-hint">Click bird to soar</div>
</div>

<script>
  import * as THREE from 'three';

  function initThree404() {
    const container = document.querySelector<HTMLElement>('[data-three-404]');
    const canvas = container?.querySelector<HTMLCanvasElement>('[data-three-canvas]');
    if (!container || !canvas) return;

    // Check prefers-reduced-motion
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // 1. Scene & Camera
    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(45, container.clientWidth / container.clientHeight, 0.1, 100);
    camera.position.set(0, 0, 8.5);

    // 2. Renderer
    const renderer = new THREE.WebGLRenderer({
      canvas,
      alpha: true,
      antialias: true,
      powerPreference: 'high-performance',
    });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    renderer.setSize(container.clientWidth, container.clientHeight);

    // 3. Lighting
    const ambientLight = new THREE.AmbientLight(0xffffff, 1.3);
    scene.add(ambientLight);

    const dirLight = new THREE.DirectionalLight(0xffffff, 2.0);
    dirLight.position.set(5, 8, 5);
    scene.add(dirLight);

    const rimLight = new THREE.DirectionalLight(0x38bdf8, 1.5);
    rimLight.position.set(-5, -3, -2);
    scene.add(rimLight);

    // Theme color helper
    function isDark(): boolean {
      return (
        document.documentElement.getAttribute('data-theme') === 'dark' ||
        (!document.documentElement.getAttribute('data-theme') &&
          window.matchMedia('(prefers-color-scheme: dark)').matches)
      );
    }

    // Common materials
    const birdMaterial = new THREE.MeshStandardMaterial({
      color: isDark() ? 0x223040 : 0xf8fafc,
      roughness: 0.45,
      metalness: 0.05,
      side: THREE.DoubleSide,
      flatShading: true,
    });

    const wireframeMaterial = new THREE.LineBasicMaterial({
      color: isDark() ? 0x38bdf8 : 0x64748b,
      linewidth: 1.5,
      transparent: true,
      opacity: 0.85,
    });

    // Helper for adding double-sided triangles
    function pushTri(arr: number[], a: THREE.Vector3, b: THREE.Vector3, c: THREE.Vector3) {
      arr.push(a.x, a.y, a.z, b.x, b.y, b.z, c.x, c.y, c.z);
      arr.push(a.x, a.y, a.z, c.x, c.y, c.z, b.x, b.y, b.z);
    }

    function pushLine(arr: number[], a: THREE.Vector3, b: THREE.Vector3) {
      arr.push(a.x, a.y, a.z, b.x, b.y, b.z);
    }

    // 4. Construct 3D Origami Crane (Bird)
    const birdGroup = new THREE.Group();

    // 4A. Body, Neck, Head, and Tail
    const bodyPositions: number[] = [];
    const bodyEdges: number[] = [];

    // Body Key Vertices
    const vBelly = new THREE.Vector3(0, -0.65, 0.0);
    const vChest = new THREE.Vector3(0, -0.15, 0.7);
    const vRump = new THREE.Vector3(0, -0.1, -0.7);
    const vRidgeF = new THREE.Vector3(0, 0.32, 0.3);
    const vRidgeB = new THREE.Vector3(0, 0.32, -0.3);

    // Body Creases (Wing Attachment Points)
    const vLWF = new THREE.Vector3(-0.35, 0.2, 0.45);
    const vLWM = new THREE.Vector3(-0.45, 0.28, 0.0);
    const vLWB = new THREE.Vector3(-0.35, 0.2, -0.45);

    const vRWF = new THREE.Vector3(0.35, 0.2, 0.45);
    const vRWM = new THREE.Vector3(0.45, 0.28, 0.0);
    const vRWB = new THREE.Vector3(0.35, 0.2, -0.45);

    // Body Facets - Left
    pushTri(bodyPositions, vChest, vBelly, vLWF);
    pushTri(bodyPositions, vLWF, vBelly, vLWM);
    pushTri(bodyPositions, vLWM, vBelly, vLWB);
    pushTri(bodyPositions, vLWB, vBelly, vRump);

    pushTri(bodyPositions, vChest, vLWF, vRidgeF);
    pushTri(bodyPositions, vRidgeF, vLWF, vLWM);
    pushTri(bodyPositions, vRidgeF, vLWM, vRidgeB);
    pushTri(bodyPositions, vRidgeB, vLWM, vLWB);
    pushTri(bodyPositions, vRidgeB, vLWB, vRump);

    // Body Facets - Right
    pushTri(bodyPositions, vChest, vRWF, vBelly);
    pushTri(bodyPositions, vRWF, vRWM, vBelly);
    pushTri(bodyPositions, vRWM, vRWB, vBelly);
    pushTri(bodyPositions, vRWB, vRump, vBelly);

    pushTri(bodyPositions, vChest, vRidgeF, vRWF);
    pushTri(bodyPositions, vRidgeF, vRWM, vRWF);
    pushTri(bodyPositions, vRidgeF, vRidgeB, vRWM);
    pushTri(bodyPositions, vRidgeB, vRWB, vRWM);
    pushTri(bodyPositions, vRidgeB, vRump, vRWB);

    // Body Crease Edges
    pushLine(bodyEdges, vChest, vBelly);
    pushLine(bodyEdges, vBelly, vRump);
    pushLine(bodyEdges, vRidgeF, vRidgeB);
    pushLine(bodyEdges, vChest, vRidgeF);
    pushLine(bodyEdges, vRump, vRidgeB);
    pushLine(bodyEdges, vLWF, vLWM);
    pushLine(bodyEdges, vLWM, vLWB);
    pushLine(bodyEdges, vRWF, vRWM);
    pushLine(bodyEdges, vRWM, vRWB);

    // 4B. Origami Neck and Head
    const vCrownL = new THREE.Vector3(-0.04, 1.45, 1.35);
    const vCrownR = new THREE.Vector3(0.04, 1.45, 1.35);
    const vThroat = new THREE.Vector3(0, 1.15, 1.25);
    const vBeak = new THREE.Vector3(0, 1.1, 1.85);

    // Neck facets
    pushTri(bodyPositions, vChest, vThroat, vCrownL);
    pushTri(bodyPositions, vChest, vCrownR, vThroat);
    pushTri(bodyPositions, vRidgeF, vCrownL, vThroat);
    pushTri(bodyPositions, vRidgeF, vThroat, vCrownR);

    // Head and Beak facets
    pushTri(bodyPositions, vCrownL, vBeak, vThroat);
    pushTri(bodyPositions, vCrownR, vThroat, vBeak);
    pushTri(bodyPositions, vCrownL, vCrownR, vBeak);

    // Neck & Head Edges
    pushLine(bodyEdges, vChest, vThroat);
    pushLine(bodyEdges, vRidgeF, vCrownL);
    pushLine(bodyEdges, vRidgeF, vCrownR);
    pushLine(bodyEdges, vCrownL, vCrownR);
    pushLine(bodyEdges, vCrownL, vBeak);
    pushLine(bodyEdges, vCrownR, vBeak);
    pushLine(bodyEdges, vThroat, vBeak);

    // 4C. Origami Tail
    const vTailTip = new THREE.Vector3(0, 1.2, -1.65);
    const vTailSpine = new THREE.Vector3(0, 0.55, -1.2);

    pushTri(bodyPositions, vRidgeB, vTailTip, vTailSpine);
    pushTri(bodyPositions, vRump, vTailSpine, vTailTip);

    pushLine(bodyEdges, vRidgeB, vTailTip);
    pushLine(bodyEdges, vRump, vTailTip);
    pushLine(bodyEdges, vTailSpine, vTailTip);

    // Assemble Body Mesh
    const bodyGeometry = new THREE.BufferGeometry();
    bodyGeometry.setAttribute('position', new THREE.Float32BufferAttribute(bodyPositions, 3));
    bodyGeometry.computeVertexNormals();
    const bodyMesh = new THREE.Mesh(bodyGeometry, birdMaterial);
    birdGroup.add(bodyMesh);

    const bodyLineGeo = new THREE.BufferGeometry();
    bodyLineGeo.setAttribute('position', new THREE.Float32BufferAttribute(bodyEdges, 3));
    const bodyLines = new THREE.LineSegments(bodyLineGeo, wireframeMaterial);
    birdGroup.add(bodyLines);

    // 4D. Left Wing (Articulated at pivot)
    const leftWingPivot = new THREE.Group();
    leftWingPivot.position.set(-0.35, 0.25, 0);

    const lwPos: number[] = [];
    const lwEdges: number[] = [];

    // Local coordinates relative to leftWingPivot
    const lwRootF = new THREE.Vector3(0, -0.05, 0.45);
    const lwRootM = new THREE.Vector3(-0.1, 0.03, 0.0);
    const lwRootB = new THREE.Vector3(0, -0.05, -0.45);
    const lwTip = new THREE.Vector3(-2.35, 0.65, -0.1);
    const lwFoldF = new THREE.Vector3(-1.05, 0.35, 0.35);
    const lwFoldB = new THREE.Vector3(-1.05, 0.28, -0.45);

    pushTri(lwPos, lwRootF, lwFoldF, lwRootM);
    pushTri(lwPos, lwRootM, lwFoldF, lwTip);
    pushTri(lwPos, lwRootM, lwTip, lwFoldB);
    pushTri(lwPos, lwRootM, lwFoldB, lwRootB);

    pushLine(lwEdges, lwRootF, lwFoldF);
    pushLine(lwEdges, lwFoldF, lwTip);
    pushLine(lwEdges, lwTip, lwFoldB);
    pushLine(lwEdges, lwFoldB, lwRootB);
    pushLine(lwEdges, lwRootM, lwFoldF);
    pushLine(lwEdges, lwRootM, lwTip);
    pushLine(lwEdges, lwRootM, lwFoldB);

    const lwGeo = new THREE.BufferGeometry();
    lwGeo.setAttribute('position', new THREE.Float32BufferAttribute(lwPos, 3));
    lwGeo.computeVertexNormals();
    const lwMesh = new THREE.Mesh(lwGeo, birdMaterial);
    leftWingPivot.add(lwMesh);

    const lwLineGeo = new THREE.BufferGeometry();
    lwLineGeo.setAttribute('position', new THREE.Float32BufferAttribute(lwEdges, 3));
    const lwLines = new THREE.LineSegments(lwLineGeo, wireframeMaterial);
    leftWingPivot.add(lwLines);

    birdGroup.add(leftWingPivot);

    // 4E. Right Wing (Articulated at pivot)
    const rightWingPivot = new THREE.Group();
    rightWingPivot.position.set(0.35, 0.25, 0);

    const rwPos: number[] = [];
    const rwEdges: number[] = [];

    // Local coordinates relative to rightWingPivot
    const rwRootF = new THREE.Vector3(0, -0.05, 0.45);
    const rwRootM = new THREE.Vector3(0.1, 0.03, 0.0);
    const rwRootB = new THREE.Vector3(0, -0.05, -0.45);
    const rwTip = new THREE.Vector3(2.35, 0.65, -0.1);
    const rwFoldF = new THREE.Vector3(1.05, 0.35, 0.35);
    const rwFoldB = new THREE.Vector3(1.05, 0.28, -0.45);

    pushTri(rwPos, rwFoldF, rwRootF, rwRootM);
    pushTri(rwPos, rwFoldF, rwRootM, rwTip);
    pushTri(rwPos, rwTip, rwRootM, rwFoldB);
    pushTri(rwPos, rwFoldB, rwRootM, rwRootB);

    pushLine(rwEdges, rwRootF, rwFoldF);
    pushLine(rwEdges, rwFoldF, rwTip);
    pushLine(rwEdges, rwTip, rwFoldB);
    pushLine(rwEdges, rwFoldB, rwRootB);
    pushLine(rwEdges, rwRootM, rwFoldF);
    pushLine(rwEdges, rwRootM, rwTip);
    pushLine(rwEdges, rwRootM, rwFoldB);

    const rwGeo = new THREE.BufferGeometry();
    rwGeo.setAttribute('position', new THREE.Float32BufferAttribute(rwPos, 3));
    rwGeo.computeVertexNormals();
    const rwMesh = new THREE.Mesh(rwGeo, birdMaterial);
    rightWingPivot.add(rwMesh);

    const rwLineGeo = new THREE.BufferGeometry();
    rwLineGeo.setAttribute('position', new THREE.Float32BufferAttribute(rwEdges, 3));
    const rwLines = new THREE.LineSegments(rwLineGeo, wireframeMaterial);
    rightWingPivot.add(rwLines);

    birdGroup.add(rightWingPivot);

    // Initial orientation: angled forward slightly and banking toward viewer
    birdGroup.rotation.x = 0.25;
    birdGroup.rotation.y = -0.45;
    birdGroup.rotation.z = -0.05;
    scene.add(birdGroup);

    // 5. Floating Ambient Dust / Paper Confetti
    const particleCount = 45;
    const particleGeo = new THREE.BufferGeometry();
    const particlePositions = new Float32Array(particleCount * 3);
    const particleSpeeds = new Float32Array(particleCount);

    for (let i = 0; i < particleCount; i++) {
      particlePositions[i * 3] = (Math.random() - 0.5) * 10;
      particlePositions[i * 3 + 1] = (Math.random() - 0.5) * 8;
      particlePositions[i * 3 + 2] = (Math.random() - 0.5) * 6;
      particleSpeeds[i] = 0.003 + Math.random() * 0.008;
    }
    particleGeo.setAttribute('position', new THREE.BufferAttribute(particlePositions, 3));

    const particleMat = new THREE.PointsMaterial({
      color: isDark() ? 0x93c5fd : 0x64748b,
      size: 0.07,
      transparent: true,
      opacity: 0.45,
    });
    const particles = new THREE.Points(particleGeo, particleMat);
    scene.add(particles);

    // 6. Theme Change Synchronization
    function updateThemeColors() {
      const dark = isDark();
      birdMaterial.color.setHex(dark ? 0x223040 : 0xf8fafc);
      wireframeMaterial.color.setHex(dark ? 0x38bdf8 : 0x64748b);
      particleMat.color.setHex(dark ? 0x7dd3fc : 0x94a3b8);
      ambientLight.intensity = dark ? 1.0 : 1.4;
      dirLight.intensity = dark ? 1.8 : 2.2;
      rimLight.color.setHex(dark ? 0x0284c7 : 0x38bdf8);
      rimLight.intensity = dark ? 2.2 : 1.2;
    }

    const themeObserver = new MutationObserver(() => updateThemeColors());
    themeObserver.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
    updateThemeColors();

    // 7. Mouse Parallax & Interactive Soaring Spin
    let targetRotX = 0.25;
    let targetRotY = -0.45;
    let spinVelocity = 0;
    let isSpinning = false;

    function onMouseMove(event: MouseEvent) {
      if (!container) return;
      const rect = container.getBoundingClientRect();
      const x = (event.clientX - rect.left) / rect.width - 0.5;
      const y = (event.clientY - rect.top) / rect.height - 0.5;
      targetRotY = -0.45 + x * 0.85;
      targetRotX = 0.25 + y * 0.55;
    }

    window.addEventListener('mousemove', onMouseMove, { passive: true });

    // Click trigger for soaring acrobatics
    function triggerSoar() {
      if (isSpinning) return;
      isSpinning = true;
      spinVelocity = Math.PI * 2;
    }

    canvas.addEventListener('click', triggerSoar);
    container.addEventListener('click', triggerSoar);

    // 8. Responsive Resize
    function onResize() {
      if (!container) return;
      const width = container.clientWidth;
      const height = container.clientHeight;
      if (width === 0 || height === 0) return;

      camera.aspect = width / height;
      camera.updateProjectionMatrix();
      renderer.setSize(width, height);
      renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    }

    const resizeObserver = new ResizeObserver(onResize);
    resizeObserver.observe(container);

    // 9. Render Loop
    let animationFrameId: number;
    const startTime = performance.now();
    let isVisible = true;

    const intersectionObserver = new IntersectionObserver(([entry]) => {
      isVisible = entry.isIntersecting;
    });
    intersectionObserver.observe(container);

    function animate() {
      animationFrameId = requestAnimationFrame(animate);
      if (!isVisible) return;

      const elapsedTime = (performance.now() - startTime) * 0.001;

      if (!prefersReducedMotion) {
        // Wing flapping cycle
        const flapRate = isSpinning ? 10.0 : 2.6;
        const flapAngle = Math.sin(elapsedTime * flapRate) * (isSpinning ? 0.45 : 0.24);
        leftWingPivot.rotation.z = -flapAngle;
        rightWingPivot.rotation.z = flapAngle;

        // Hover bobbing motion coordinated with wings
        const bob = Math.sin(elapsedTime * 2.6) * 0.14;
        const driftRoll = Math.sin(elapsedTime * 0.9) * 0.06;
        birdGroup.position.y = bob;

        // Interactive soaring loop
        if (isSpinning) {
          birdGroup.rotation.z += spinVelocity * 0.12;
          spinVelocity *= 0.92;
          if (spinVelocity < 0.01) {
            isSpinning = false;
            spinVelocity = 0;
            birdGroup.rotation.z = -0.05;
          }
        } else {
          // Smooth parallax tracking
          birdGroup.rotation.x += (targetRotX - birdGroup.rotation.x) * 0.06;
          birdGroup.rotation.y += (targetRotY - birdGroup.rotation.y) * 0.06;
          birdGroup.rotation.z += (-0.05 + driftRoll - birdGroup.rotation.z) * 0.06;
        }

        // Ambient dust motes drifting upward
        const pos = particleGeo.attributes.position.array as Float32Array;
        for (let i = 0; i < particleCount; i++) {
          pos[i * 3 + 1] += particleSpeeds[i];
          if (pos[i * 3 + 1] > 4) {
            pos[i * 3 + 1] = -4;
          }
        }
        particleGeo.attributes.position.needsUpdate = true;
      }

      renderer.render(scene, camera);
    }

    animate();

    // Cleanup on window unload
    window.addEventListener(
      'pagehide',
      () => {
        cancelAnimationFrame(animationFrameId);
        resizeObserver.disconnect();
        intersectionObserver.disconnect();
        themeObserver.disconnect();
        window.removeEventListener('mousemove', onMouseMove);
        renderer.dispose();
      },
      { once: true }
    );
  }

  // Initialize when DOM is ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initThree404, { once: true });
  } else {
    initThree404();
  }
</script>

<style>
  .three-404-container {
    position: relative;
    width: 100%;
    height: 380px;
    max-width: 440px;
    display: flex;
    align-items: center;
    justify-content: center;
    user-select: none;
    cursor: pointer;
  }

  .three-404-canvas {
    width: 100% !important;
    height: 100% !important;
    display: block;
    outline: none;
  }

  .three-404-hint {
    position: absolute;
    bottom: 8px;
    font-size: var(--text-caption-2, 0.6875rem);
    color: var(--label-tertiary);
    background: color-mix(in srgb, var(--fill-quaternary) 80%, transparent);
    padding: 0.2rem 0.6rem;
    border-radius: var(--radius-full, 999px);
    border: 1px solid var(--separator);
    pointer-events: none;
    opacity: 0.7;
    transition: opacity var(--duration-fast) ease;
  }

  .three-404-container:hover .three-404-hint {
    opacity: 1;
    color: var(--label-secondary);
  }

  @media (max-width: 768px) {
    .three-404-container {
      height: 280px;
      max-width: 320px;
      margin: 0 auto;
    }
  }
</style>
