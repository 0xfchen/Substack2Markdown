---
/**
 * Three404Scene.astro
 *
 * Interactive 3D scene: SpaceX Starship (Dark Mode) vs Origami Paper Plane (Light Mode)
 * with extruded 3D chrome "404" typography and 2D perspective starfield.
 */
---

<!-- Full-Page Deep Space Starfield -->
<canvas class="three-404-starfield-canvas" data-starfield-canvas aria-hidden="true"></canvas>

<!-- Full-Page Unified 3D Aerospace Scene -->
<canvas class="three-404-canvas" data-three-canvas aria-hidden="true"></canvas>

<div class="three-404-container" data-three-404 aria-hidden="true">
  <div class="three-404-hint" data-three-hint>Click Starship to fly</div>
</div>

<script>
  import { initThree404 } from '../scripts/three-404';

  // Initialize when DOM is ready and on Astro page transitions
  document.addEventListener('astro:page-load', () => initThree404());
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => initThree404(), { once: true });
  } else {
    initThree404();
  }
</script>

<style>
  .three-404-starfield-canvas {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    pointer-events: none;
    z-index: 0;
    display: block;
  }

  .three-404-canvas {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    pointer-events: none;
    z-index: 1;
    display: block;
    outline: none;
  }

  .three-404-container {
    position: relative;
    width: 380px;
    max-width: 100%;
    height: 480px;
    display: flex;
    align-items: center;
    justify-content: center;
    user-select: none;
    cursor: pointer;
    z-index: 2;
  }

  .three-404-hint {
    position: absolute;
    bottom: 14px;
    left: 50%;
    transform: translateX(-50%);
    font-size: var(--text-caption-2, 0.6875rem);
    color: var(--label-tertiary);
    background: color-mix(in srgb, var(--fill-quaternary) 80%, transparent);
    padding: 0.25rem 0.85rem;
    border-radius: var(--radius-full, 999px);
    border: 1px solid var(--separator);
    pointer-events: none;
    opacity: 0.75;
    white-space: nowrap;
    transition: opacity var(--duration-fast) ease, color var(--duration-fast) ease;
  }

  .three-404-container:hover .three-404-hint {
    opacity: 1;
    color: var(--label-secondary);
  }

  @media (max-width: 768px) {
    .three-404-container {
      height: 380px;
      max-width: 320px;
      margin: 0 auto;
    }
  }
</style>
