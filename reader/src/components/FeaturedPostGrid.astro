---
import type { CollectionEntry } from 'astro:content';
import FormattedDate from './FormattedDate.astro';
import { withBase } from '../utils/paths';
import { getTagColors } from '../utils/graph-colors';

type PostEntry = CollectionEntry<'posts'>;

type Props = {
  posts: PostEntry[];
  basePath?: string;
  variant?: 'home' | 'related';
};

const { posts, basePath = '/posts', variant = 'home' } = Astro.props;
const postSlug = (id: string) => id;

const getCoverSrc = (post: PostEntry): string | undefined => {
  if (post.data.cover_image) return post.data.cover_image;
  if (post.data.heroImage?.src) return post.data.heroImage.src;
  return undefined;
};
---

<div class:list={['featured-post-grid', `featured-post-grid--${variant}`]}>
  {
    posts.map((post) => {
      const coverSrc = getCoverSrc(post);
      return (
        <a
          href={withBase(`${basePath}/${postSlug(post.id)}/`)}
          class="featured-post-card"
        >
          {coverSrc && (
            <div class="featured-post-card-media">
              <img
                src={coverSrc}
                alt={post.data.title}
                loading="lazy"
                decoding="async"
                class="featured-post-card-img"
                onerror="this.closest('.featured-post-card-media')?.remove()"
              />
            </div>
          )}
          <div class="featured-post-card-body">
            <div class="featured-post-card-meta">
              {post.data.category && (
                <span
                  class="featured-post-card-category"
                  style={getTagColors(post.data.category).style}
                >
                  {post.data.category}
                </span>
              )}
              <p class="featured-post-card-date">
                <FormattedDate date={post.data.pubDate} />
              </p>
            </div>
            <h3 class="featured-post-card-title">{post.data.title}</h3>
            {post.data.description && (
              <p class="featured-post-card-desc">{post.data.description}</p>
            )}
          </div>
        </a>
      );
    })
  }
</div>

<style>
.featured-post-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: var(--space-4, 1rem);
  align-items: stretch;
}

.featured-post-card {
  position: relative;
  display: flex;
  flex-direction: column;
  background: var(--fill-quaternary);
  border: 1px solid var(--separator);
  border-radius: var(--radius-lg);
  overflow: hidden;
  text-decoration: none;
  color: inherit;
  transition:
    transform var(--duration-fast) var(--ease-out),
    box-shadow var(--duration-fast) var(--ease-out),
    border-color var(--duration-fast) var(--ease-out);
}

.featured-post-card:hover {
  transform: translateY(-2px);
  border-color: color-mix(in srgb, var(--label-primary) 24%, var(--separator));
  box-shadow: var(--shadow-sm);
}

.featured-post-card-media {
  position: relative;
  width: 100%;
  aspect-ratio: 16 / 9;
  max-height: 125px;
  overflow: hidden;
  background: var(--fill-secondary);
}

.featured-post-card-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transition: transform var(--duration-normal) var(--ease-out);
}

.featured-post-card:hover .featured-post-card-img {
  transform: scale(1.04);
}

.featured-post-card-body {
  display: flex;
  flex-direction: column;
  flex: 1;
  padding: 0.8rem 0.85rem 0.95rem;
  gap: 0.5rem;
}

.featured-post-card-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-2);
  width: 100%;
}

.featured-post-card-category {
  --cat-color: var(--tag-color-light, var(--color-blue));
  font-size: 0.68rem;
  font-weight: var(--weight-accent-label, 600);
  text-transform: uppercase;
  letter-spacing: 0.05em;
  color: var(--cat-color);
  background: color-mix(in srgb, var(--cat-color) 10%, transparent);
  border: 1px solid color-mix(in srgb, var(--cat-color) 20%, transparent);
  padding: 2px 7px;
  border-radius: var(--radius-sm);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: min(220px, calc(100% - 90px));
  transition: color var(--duration-fast) ease, background-color var(--duration-fast) ease, border-color var(--duration-fast) ease;
}

:global([data-theme='dark']) .featured-post-card-category {
  --cat-color: var(--tag-color-dark, var(--color-blue));
  background: color-mix(in srgb, var(--cat-color) 15%, transparent);
  border-color: color-mix(in srgb, var(--cat-color) 30%, transparent);
}

@media (prefers-color-scheme: dark) {
  :global(:root:not([data-theme='light'])) .featured-post-card-category {
    --cat-color: var(--tag-color-dark, var(--color-blue));
    background: color-mix(in srgb, var(--cat-color) 15%, transparent);
    border-color: color-mix(in srgb, var(--cat-color) 30%, transparent);
  }
}

:global([data-theme='light']) .featured-post-card-category {
  --cat-color: var(--tag-color-light, var(--color-blue));
  background: color-mix(in srgb, var(--cat-color) 10%, transparent);
  border-color: color-mix(in srgb, var(--cat-color) 20%, transparent);
}

.featured-post-card-date {
  font-size: 0.72rem;
  color: var(--label-tertiary);
  margin: 0;
  margin-left: auto;
  white-space: nowrap;
  flex-shrink: 0;
}

.featured-post-card-title {
  font-size: 0.88rem;
  font-weight: 600;
  line-height: 1.35;
  color: var(--label-primary);
  margin: 0;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  transition: color var(--duration-fast) var(--ease-out);
}

.featured-post-card:hover .featured-post-card-title {
  color: var(--color-blue);
}

.featured-post-card-desc {
  font-size: 0.76rem;
  line-height: 1.45;
  color: var(--label-secondary);
  margin: 0;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

@media (max-width: 720px) {
  .featured-post-grid {
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  }
}

@media (max-width: 480px) {
  .featured-post-grid {
    grid-template-columns: 1fr;
  }

  .featured-post-card-media {
    max-height: 150px;
  }
}
</style>
