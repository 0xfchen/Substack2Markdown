---
type Props = {
  slug: string;
};

const { slug } = Astro.props;
const steps = Array.from({ length: 20 }, (_, i) => (i + 1) * 5); // 5, 10, 15, ..., 100
---

<aside class="progress-rail" data-progress-rail data-slug={slug} aria-label="Reading progress">
  <div class="rail-inner">
    <div class="rail-ticks" role="navigation" aria-label="Article sections">
      {
        steps.map((percent) => {
          const isMajor = percent % 10 === 0;
          return (
            <button
              type="button"
              class:list={['rail-tick', !isMajor && 'tick-minor']}
              data-tick={percent}
              data-is-major={isMajor ? 'true' : 'false'}
              aria-label={`Jump to ${percent}% of article`}
              title={`${percent}%`}
            >
              <span class="tick-line" />
              <span class="tick-tooltip">{percent}%</span>
            </button>
          );
        })
      }
    </div>
  </div>
</aside>

<div class="reading-progress-toast" data-reading-toast aria-live="polite"></div>

<script>
  import { mountProgressRail } from '../scripts/progress-rail';

  mountProgressRail();
</script>

<style>
  .progress-rail {
    --rail-teal: var(--color-teal);
    --rail-teal-glow: var(--color-teal-glow);
    position: fixed;
    top: 50%;
    transform: translateY(-50%);
    left: clamp(20px, 2.5vw, 36px);
    z-index: 40;
    user-select: none;
    pointer-events: auto;
  }

  .rail-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .rail-ticks {
    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  .rail-tick {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2px 4px;
    background: transparent;
    border: none;
    cursor: pointer;
    outline: none;
  }

  .tick-line {
    display: block;
    width: 12px;
    height: 1.5px;
    border-radius: 999px;
    background: var(--separator, rgba(0, 0, 0, 0.22));
    transition: width 200ms cubic-bezier(0.16, 1, 0.3, 1), background-color 180ms ease, box-shadow 180ms ease;
  }

  /* Minor (5%) ticks are narrower */
  .rail-tick.tick-minor .tick-line {
    width: 6px;
    height: 1.5px;
    opacity: 0.7;
  }

  :global([data-theme='dark']) .tick-line {
    background: rgba(255, 255, 255, 0.2);
  }

  /* Passed / read ticks */
  .rail-tick.is-active .tick-line {
    width: 14px;
    background: color-mix(in srgb, var(--rail-teal) 60%, var(--label-secondary));
  }

  .rail-tick.tick-minor.is-active .tick-line {
    width: 9px;
    opacity: 0.9;
  }

  :global([data-theme='dark']) .rail-tick.is-active .tick-line {
    background: color-mix(in srgb, var(--rail-teal) 70%, rgba(255, 255, 255, 0.4));
  }

  /* Current active focal tick being read */
  .rail-tick.is-current .tick-line {
    width: 18px;
    height: 1.5px;
    opacity: 1;
    background: var(--rail-teal);
    box-shadow: 0 0 7px var(--rail-teal-glow);
  }

  .rail-tick.tick-minor.is-current .tick-line {
    width: 14px;
  }

  /* Hover state */
  .rail-tick:hover .tick-line {
    width: 20px;
    height: 1.5px;
    opacity: 1;
    background: var(--rail-teal);
    box-shadow: 0 0 8px var(--rail-teal-glow);
  }

  .rail-tick.tick-minor:hover .tick-line {
    width: 16px;
  }

  /* Tooltip: visible on hover AND on current active tick */
  .tick-tooltip {
    position: absolute;
    left: calc(100% + 8px);
    font-size: 0.6875rem;
    font-weight: 600;
    color: var(--label-tertiary);
    opacity: 0;
    pointer-events: none;
    transform: translateX(-4px);
    transition: opacity 180ms ease, transform 180ms ease;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  .rail-tick.is-current .tick-tooltip {
    opacity: 0.85;
    color: var(--rail-teal);
    transform: translateX(0);
  }

  .rail-tick:hover .tick-tooltip {
    opacity: 1;
    color: var(--label-primary);
    transform: translateX(0);
  }

  /* Hide rail on screens where content is too close to left margin */
  @media (max-width: 960px) {
    .progress-rail {
      display: none;
    }
  }
</style>

