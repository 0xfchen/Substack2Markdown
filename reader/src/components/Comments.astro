---
import config from '../../astro-theme-config';
import { withBase, withoutBase } from '../utils/paths';

const comments = (config.comments || { mode: 'off' }) as Record<string, any>;
const commentsMode = import.meta.env.PUBLIC_GISCUS_MODE || comments.mode || 'off';
const canUseCommentsMode =
  commentsMode === 'giscus' || commentsMode === 'giscus-custom';
const giscusConfig = (comments.giscus || {}) as Record<string, any>;
const giscus: Record<string, any> = {
  mapping: 'pathname',
  strict: '0',
  emitMetadata: '0',
  theme: 'preferred_color_scheme',
  lang: 'en',
  loading: 'eager',
  customLightTheme: '/giscus-light.css',
  customDarkTheme: '/giscus-dark.css',
  ...giscusConfig,
  repo: import.meta.env.PUBLIC_GISCUS_REPO || giscusConfig.repo || '',
  repoId: import.meta.env.PUBLIC_GISCUS_REPO_ID || giscusConfig.repoId || '',
  category: import.meta.env.PUBLIC_GISCUS_CATEGORY || giscusConfig.category || '',
  categoryId: import.meta.env.PUBLIC_GISCUS_CATEGORY_ID || giscusConfig.categoryId || '',
  reactionsEnabled:
    import.meta.env.PUBLIC_GISCUS_REACTIONS_ENABLED || giscusConfig.reactionsEnabled || '0',
};
const canRenderGiscus =
  canUseCommentsMode &&
  comments.provider === 'giscus' &&
  Boolean(giscus.repo && giscus.repoId && giscus.category && giscus.categoryId);
const giscusTerm = withoutBase(Astro.url.pathname).replace(/^\/+/, '');
const giscusMapping = giscus.mapping === 'pathname' ? 'specific' : (giscus.mapping || 'specific');
---

{
  canRenderGiscus && (
    <section class="comments-section" data-pagefind-ignore="all" aria-label="Comments">
      <p class="comments-label">Comments</p>
      <div
        id="giscus-container"
        class="giscus"
        data-repo={giscus.repo}
        data-repo-id={giscus.repoId}
        data-category={giscus.category}
        data-category-id={giscus.categoryId}
        data-mapping={giscusMapping}
        data-term={giscusTerm}
        data-strict={giscus.strict}
        data-reactions-enabled={giscus.reactionsEnabled}
        data-emit-metadata={giscus.emitMetadata}
        data-input-position="bottom"
        data-theme={giscus.theme}
        data-theme-mode={commentsMode === 'giscus-custom' ? 'custom' : 'default'}
        data-lang={giscus.lang}
        data-loading={giscus.loading}
        data-light-theme-path={withBase(giscus.customLightTheme)}
        data-dark-theme-path={withBase(giscus.customDarkTheme)}
      />
    </section>
  )
}

{
  canRenderGiscus && (
    <script>
      import { mountGiscusComments } from '../scripts/giscus-comments';

      mountGiscusComments();
    </script>
  )
}

<style>
.comments-section {
  max-width: var(--max-width-content);
  margin-top: var(--space-8);
  padding-top: var(--space-4);
  border-top: 1px solid rgba(60, 60, 67, 0.08);
}

.comments-label {
  margin: 0 0 var(--space-4);
  color: var(--label-tertiary);
  font-size: var(--text-caption-1);
  font-weight: var(--weight-accent-label);
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.giscus {
  --giscus-unmeasured-height: clamp(14rem, 34vh, 18rem);

  min-height: var(--giscus-unmeasured-height);
}

.giscus :global(iframe.giscus-frame) {
  display: block;
  width: 100%;
  opacity: 1;
}

.giscus.is-ready :global(iframe.giscus-frame) {
  opacity: 1 !important;
}

.giscus.is-loading:not(.is-ready) :global(iframe.giscus-frame) {
  opacity: 0 !important;
  pointer-events: none;
}

.giscus:not(.is-resized) :global(iframe.giscus-frame) {
  min-height: var(--giscus-unmeasured-height);
}
</style>
