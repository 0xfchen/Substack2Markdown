---
import { withBase } from '../utils/paths';

interface Props {
  showHome?: boolean;
}

const { showHome = true } = Astro.props;
const homeUrl = withBase('/');
---

<div class="floating-navigation" data-floating-navigation aria-label="Quick navigation">
  <button
    type="button"
    class="floating-navigation-btn"
    id="floating-scroll-top"
    aria-label="Scroll to top"
    title="Back to top"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="18"
      height="18"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2.2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <polyline points="18 15 12 9 6 15"></polyline>
    </svg>
    <span class="floating-navigation-tooltip">Top</span>
  </button>

  {showHome && (
    <a
      href={homeUrl}
      class="floating-navigation-btn"
      id="floating-go-home"
      aria-label="Go to homepage"
      title="Home"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
        <polyline points="9 22 9 12 15 12 15 22"></polyline>
      </svg>
      <span class="floating-navigation-tooltip">Home</span>
    </a>
  )}
</div>

<script>
  import { flushPendingUpdates } from '../scripts/reading-tracker';

  function initFloatingNavigation() {
    const btnTop = document.getElementById('floating-scroll-top');
    if (btnTop && !btnTop.hasAttribute('data-nav-ready')) {
      btnTop.setAttribute('data-nav-ready', 'true');
      btnTop.addEventListener('click', (e) => {
        e.preventDefault();
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });
    }

    const btnHome = document.getElementById('floating-go-home');
    if (btnHome && !btnHome.hasAttribute('data-nav-ready')) {
      btnHome.setAttribute('data-nav-ready', 'true');
      btnHome.addEventListener('click', (e) => {
        const currentPath = window.location.pathname.replace(/\/$/, '') || '/';
        const targetPath = (btnHome.getAttribute('href') || '/').replace(/\/$/, '') || '/';
        if (currentPath === targetPath) {
          e.preventDefault();
          window.scrollTo({ top: 0, behavior: 'smooth' });
        } else {
          // Immediately flush any in-progress reading updates to disk
          void flushPendingUpdates();
        }
      });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initFloatingNavigation, { once: true });
  } else {
    initFloatingNavigation();
  }
</script>

<style>
  .floating-navigation {
    --nav-teal: var(--color-teal, #0d9488);
    --nav-teal-glow: var(--color-teal-glow, rgba(45, 212, 191, 0.35));
    position: fixed;
    bottom: 24px;
    right: 24px;
    z-index: 60;
    display: flex;
    flex-direction: column;
    gap: 10px;
    align-items: center;
    pointer-events: auto;
  }

  .floating-navigation-btn {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: color-mix(in srgb, var(--bg-primary, #ffffff) 82%, transparent);
    color: var(--label-secondary, #6e6e73);
    border: 1px solid var(--separator, rgba(0, 0, 0, 0.12));
    box-shadow: 0 3px 12px rgba(0, 0, 0, 0.08), 0 1px 3px rgba(0, 0, 0, 0.04);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    cursor: pointer;
    text-decoration: none;
    transition:
      color 180ms ease,
      background-color 180ms ease,
      border-color 180ms ease,
      box-shadow 180ms ease,
      transform 180ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  :global([data-theme='dark']) .floating-navigation-btn {
    background: color-mix(in srgb, var(--bg-secondary, #1c1c1e) 82%, transparent);
    border-color: rgba(255, 255, 255, 0.14);
    color: var(--label-secondary, #a1a1a6);
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.4);
  }

  .floating-navigation-btn:hover {
    color: var(--nav-teal);
    border-color: color-mix(in srgb, var(--nav-teal) 45%, var(--separator, rgba(0, 0, 0, 0.15)));
    box-shadow: 0 5px 16px rgba(0, 0, 0, 0.12), 0 0 12px var(--nav-teal-glow);
    transform: translateY(-2px);
  }

  :global([data-theme='dark']) .floating-navigation-btn:hover {
    color: var(--nav-teal);
    border-color: color-mix(in srgb, var(--nav-teal) 50%, rgba(255, 255, 255, 0.2));
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.5), 0 0 14px var(--nav-teal-glow);
  }

  .floating-navigation-btn:active {
    transform: scale(0.92);
  }

  /* Tooltips to the left of the button */
  .floating-navigation-tooltip {
    position: absolute;
    right: calc(100% + 10px);
    padding: 4px 8px;
    font-size: 0.6875rem;
    font-weight: 600;
    line-height: 1;
    border-radius: 6px;
    background: color-mix(in srgb, var(--bg-primary, #ffffff) 92%, transparent);
    color: var(--label-primary, #1d1d1f);
    border: 1px solid var(--separator, rgba(0, 0, 0, 0.1));
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    white-space: nowrap;
    pointer-events: none;
    opacity: 0;
    transform: translateX(5px);
    transition: opacity 160ms ease, transform 160ms ease;
  }

  :global([data-theme='dark']) .floating-navigation-tooltip {
    background: color-mix(in srgb, var(--bg-secondary, #1c1c1e) 92%, transparent);
    border-color: rgba(255, 255, 255, 0.12);
    color: var(--label-primary, #f5f5f7);
    box-shadow: 0 3px 10px rgba(0, 0, 0, 0.4);
  }

  .floating-navigation-btn:hover .floating-navigation-tooltip {
    opacity: 1;
    transform: translateX(0);
  }

  @media (max-width: 640px) {
    .floating-navigation {
      bottom: 16px;
      right: 16px;
      gap: 8px;
    }

    .floating-navigation-btn {
      width: 36px;
      height: 36px;
    }

    .floating-navigation-tooltip {
      display: none;
    }
  }
</style>

