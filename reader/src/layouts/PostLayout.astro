---
import 'toc-rail/style.css';
import '../styles/layouts/post.css';
import '../styles/components/annotations.css';
import type { CollectionEntry } from 'astro:content';
import Comments from '../components/Comments.astro';
import FeaturedPostGrid from '../components/FeaturedPostGrid.astro';
import FormattedDate from '../components/FormattedDate.astro';
import ImageLightbox from '../components/ImageLightbox.astro';
import ScrollFocus from '../components/ScrollFocus.astro';
import ReadingStatusButton from '../components/ReadingStatusButton.astro';
import ProgressRail from '../components/ProgressRail.astro';
import AnnotationToolbar from '../components/AnnotationToolbar.astro';
import AnnotationsPanel from '../components/AnnotationsPanel.astro';
import BaseLayout from './BaseLayout.astro';
import { SITE_AUTHOR, SITE_LANG, SITE_TITLE } from '../consts';
import { getUiText } from '../ui';
import { withBase } from '../utils/paths';
import { serializeScriptJson } from '../utils/serialize-script-json';
import { getTagColors } from '../utils/graph-colors';

type Props = CollectionEntry<'posts'>['data'] & {
  slug?: string;
  readingTime?: number;
  relatedPosts?: CollectionEntry<'posts'>[];
};

const {
  slug = '',
  title,
  description,
  pubDate,
  updatedDate,
  heroImage,
  readingTime,
  focusEffect,
  tags = [],
  relatedPosts = [],
} = Astro.props;

const uiText = getUiText();
const libraryBase = withBase('/');

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const pubDateISO = pubDate.toISOString();
const updatedDateISO = updatedDate?.toISOString();

const jsonLd = serializeScriptJson({
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  datePublished: pubDateISO,
  ...(updatedDateISO && { dateModified: updatedDateISO }),
  url: canonicalURL.href,
  ...(heroImage && { image: new URL(heroImage.src, Astro.site).href }),
  author: { '@type': 'Person', name: SITE_AUTHOR },
  publisher: { '@type': 'Organization', name: SITE_TITLE },
  inLanguage: SITE_LANG,
});
---

<BaseLayout
  title={title}
  description={description}
  image={heroImage}
  type="article"
  pubDate={pubDateISO}
  updatedDate={updatedDateISO}
  bodyClass="post-page"
  showFloatingNavigation={true}
  slug={slug}
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={jsonLd} />
  </Fragment>

  {focusEffect && <ScrollFocus variant={focusEffect} />}

  <main id="main-content" class="post-main" data-post-slug={slug}>
    <article data-pagefind-body>
      <div class="post-top-nav">
        <a
          href={libraryBase}
          class="back-link"
          data-astro-prefetch="hover"
          data-slug={slug}
          id="post-top-back-link"
        >
          {uiText.backLink}
        </a>
        {slug && <ReadingStatusButton slug={slug} />}
      </div>

      <header class="post-header">
        <div class="post-accent"></div>
        <div class="post-meta">
          <FormattedDate class="meta-date" date={pubDate} />
          {
            readingTime && (
              <>
                <span class="dot">·</span>
                <span class="meta-item">{uiText.readingTime(readingTime)}</span>
              </>
            )
          }
          {
            updatedDate && (
              <>
                <span class="dot">·</span>
                <span class="meta-updated">
                  {uiText.updated} <FormattedDate date={updatedDate} />
                </span>
              </>
            )
          }
          {
            slug && (
              <>
                <span class="dot">·</span>
                <button
                  type="button"
                  class="post-notes-badge"
                  id="post-notes-toggle"
                  data-count="0"
                  aria-label="Open annotations and notes"
                  title="Open article highlights and notes"
                >
                  <span class="notes-icon">✏️</span>
                  <span id="post-notes-count">0 notes</span>
                </button>
              </>
            )
          }
        </div>
        <h1 class="post-title" data-pagefind-meta="title">{title}</h1>
        {description && <p class="post-description">{description}</p>}
        {
          tags && tags.length > 0 && (
            <div class="post-tags">
              {tags.map((tag) => {
                const { style } = getTagColors(tag);
                return (
                  <span class="tag-pill" style={style}>
                    {tag}
                  </span>
                );
              })}
            </div>
          )
        }
      </header>

      <div class="post-divider"></div>

      {slug && <ProgressRail slug={slug} />}

      <div class="prose" id="prose-content">
        <slot />
      </div>

      {
        relatedPosts.length > 0 && (
          <section class="related-section" data-pagefind-ignore="all">
            <div class="related-header">
              <p class="related-label">{uiText.relatedPosts}</p>
              <a href={libraryBase} class="related-view-all">
                {uiText.allPosts}
              </a>
            </div>
            <FeaturedPostGrid posts={relatedPosts} variant="related" />
          </section>
        )
      }
    </article>
    <Comments />
    {
      slug && (
        <>
          <AnnotationToolbar />
          <AnnotationsPanel slug={slug} />
        </>
      )
    }
  </main>
  <ImageLightbox />

  <script>
    import { mountReadingRailLoader } from '../scripts/reading-rail-loader';
    import { initBackToLibraryLink } from '../scripts/navigation-utils';

    mountReadingRailLoader();
    initBackToLibraryLink();
  </script>
</BaseLayout>
