---
import '../styles/pages/not-found.css';
import BaseLayout from '../layouts/BaseLayout.astro';
import Three404Scene from '../components/Three404Scene.astro';
import { withBase } from '../utils/paths';
---

<BaseLayout
  title="Page not found"
  description="The page you requested does not exist."
  robots="noindex, follow"
  canonicalUrl={withBase('/404.html')}
  pageUrl={withBase('/404.html')}
>
  <main class="not-found-main" id="main-content">
    <div class="not-found-grid">
      <div class="not-found-inner">
        <div class="not-found-code-container" data-three-code-container title="Click to launch Starship around 404">
          <span class="sr-only">404</span>
        </div>
        <h1 class="not-found-title">Page not found</h1>
        <p class="not-found-desc">The URL may be wrong, or the page may have drifted away into the void.</p>
        <div class="not-found-actions">
          <a href={withBase('/')} class="btn btn-primary">Library</a>
          <a href={withBase('/search')} class="btn btn-secondary">Search</a>
        </div>
      </div>
      <div class="not-found-visual">
        <Three404Scene />
      </div>
    </div>
  </main>
</BaseLayout>
