# Ignore Python-related files
.env
/config.py
setup.py
*egg-info/
**/__pycache__/

# Ignore virtual environment directories
.venv/

# Ignore editor/IDE configuration files
.idea/
.vscode/

# Ignore all files in content/ except README.md
content/*
!content/README.md

# Ignore Astro reader dependencies and build output
reader/node_modules/
reader/.astro/
reader/dist/
reader/.github/

